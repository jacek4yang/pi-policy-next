{
  "name": "pi-policy-next",
  "version": "0.1.0",
  "description": "Deterministic authorization policy for Pi coding agent: action classification, protected resources, material-action approval intents, and fail-closed gating before any side effect.",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19"
  },
  "private": true,
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "tsx --test test/*.test.ts",
    "bench": "tsx bench/policy-overhead.ts",
    "ci": "npm run check:pi && npm run typecheck && npm run lint && npm run format:check && npm run test",
    "package-smoke": "node scripts/package-smoke.mjs",
    "smoke:pi": "node scripts/pi-load-smoke.mjs",
    "check:pi": "node scripts/check-pi-version.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@types/node": "^24.0.0",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
